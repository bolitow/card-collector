# Copier en .env. Toutes les variables sont préfixées CC_ (backend/app/config.py).
CC_ENV=prod                      # dev | staging | prod
CC_APP_URL=https://exemple.fr    # adresse publique : liens des e-mails, contrôle d'origine
CC_PRODUCT_NAME="Mes collections de cartes"
CC_DATABASE_URL=postgresql+psycopg://utilisateur:motdepasse@hote:5432/base
CC_COOKIE_SECURE=true

# Photos : stockage objet privé, compatible S3 (hébergé dans l'UE)
CC_STORAGE_BACKEND=s3
CC_S3_BUCKET=
CC_S3_ENDPOINT=https://s3.fr-par.scw.cloud
CC_S3_REGION=fr-par
CC_S3_ACCESS_KEY=
CC_S3_SECRET_KEY=

# E-mails de service (SMTP)
CC_MAIL_BACKEND=smtp
CC_MAIL_FROM="Mes collections de cartes <bonjour@exemple.fr>"
CC_SMTP_HOST=smtp.tem.scw.cloud
CC_SMTP_PORT=587
CC_SMTP_USER=
CC_SMTP_PASSWORD=

# IA : off | fake | anthropic. La clé reste sur le serveur.
CC_AI_BACKEND=anthropic
CC_ANTHROPIC_API_KEY=
CC_AI_MODEL_PHOTO=claude-haiku-5-5
CC_AI_MODEL_IMPORT=claude-sonnet-5-5
CC_AI_QUOTA_DAY=10
CC_AI_QUOTA_MONTH=100

# Déploiement (deploy/docker-compose.prod.yml)
DOMAIN=exemple.fr
IMAGE=rg.fr-par.scw.cloud/espace/card-collector:latest
